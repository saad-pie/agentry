{
  "id": "agent.dsh",
  "kind": "agent",
  "invoked_via": "invoker.in_process_js",
  "handler": "agent.dsh",
  "accepts": {
    "prompt": "string",
    "workspace": { "type": "string", "optional": true },
    "timeout_ms": { "type": "number", "optional": true }
