    "captured_at": "number",
    "width": "number",
    "height": "number"
  },
  "requires": {
    "npm": ["playwright"],
    "post_install": "npx playwright install chromium"
  },
  "source": "adopted:github:microsoft/playwright",
  "notes": "https://github.com/microsoft/playwright",
  "adopted_from": {
    "candidate_id": "microsoft/playwright",
