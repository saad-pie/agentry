{
  "id": "agentry.task.run",
  "kind": "agent",
  "invoked_via": "invoker.in_process_js",
  "handler": "agentry.task.run",
  "accepts": {
    "intent": { "type": "string", "optional": true },
    "plan": { "type": "array", "optional": true },
    "task_id": { "type": "string", "optional": true },
    "session_id": { "type": "string", "optional": true },
    "parent_task_id": { "type": "string", "optional": true },
    "budget": { "type": "object", "optional": true },
    "retry_on_missing_capability": { "type": "boolean", "optional": true },
    "ensure_timeout_ms": { "type": "number", "optional": true }
  },
  "produces": {
    "ok": "boolean",
    "task_id": "string",
    "state": "string",
    "artifacts": "array",
    "trace": "array",
    "error": "object|null"
  },
  "cost": { "money_usd": 0, "time_ms": 120000 },
  "limits": {},
  "source": "seeded:agentry",
  "notes": "v0.37.0 — on step failure with error.code=invalid_capability, calls agentry.ensure once and retries the step once. Disable via retry_on_missing_capability=false. ensure_timeout_ms defaults 120000, clamped 2000-600000. Retry metadata is nested under trace[i].retry."
}
