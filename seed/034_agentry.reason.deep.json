{
  "id": "agentry.reason.deep",
  "kind": "agent",
  "invoked_via": "invoker.in_process_js",
  "handler": "agentry.reason.deep",
  "accepts": {
    "failure": { "type": "string", "optional": true },
    "intent": { "type": "string", "optional": true },
    "attempted": { "type": "array", "optional": true },
    "workspace_id": { "type": "string", "optional": true },
    "session_id": { "type": "string", "optional": true },
    "repair_context": { "type": "object", "optional": true }
  },
  "produces": {
    "analysis": "string",
    "missing": "object|null",
    "immediate_action": "string",
    "suggestions": "array",
    "gap_recorded": "string|null",
    "model_used": "string",
    "tools_used": "array",
    "repair_action": { "type": "string", "optional": true },
    "patched_handler_code": { "type": "string|null", "optional": true },
    "reason_for_action": { "type": "string|null", "optional": true }
  },
  "cost": { "money_usd": 0, "time_ms": 30000 },
  "limits": {},
  "source": "seeded:agentry",
  "notes": "v0.32.2 — `failure` is optional so repair mode (which fires on `repair_context` alone) satisfies the accepts gate. `repair_context` is declared so callers don't need a synthetic `failure` string. Produces declares repair-mode output fields. Handler enforces 'failure or intent or repair_context' at the top of the function."
}
